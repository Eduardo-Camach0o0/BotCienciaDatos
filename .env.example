# ============================================================================
# PLANTILLA DE VARIABLES DE ENTORNO (.env.example) - VERSIÓN v0.1.0
# ⚠️ IMPORTANTE:
# 1. Copia este archivo como '.env' en tu máquina local.
# 2. NUNCA subas tu archivo '.env' a GitHub.
# 3. NUNCA pases tus llaves MEXC_API_KEY ni MEXC_SECRET_KEY al LLM.
# ============================================================================

# --- Configuración del LLM Local (Solo localhost permitido) ---
VITE_LOCAL_LLM_URL=http://localhost:11434/api/generate
VITE_LOCAL_LLM_MODEL=llama3.2

# --- Configuración de Mercado (MEXC / Polymarket) ---
VITE_EXCHANGE_TARGET=MEXC
VITE_DEFAULT_SYMBOL=BTCUSDT
VITE_DEFAULT_INTERVAL=5m

# --- Credenciales del Exchange (USO EXCLUSIVO DEL MOTOR DE ÓRDENES, AISLADO DE LA IA) ---
MEXC_API_KEY=TU_API_KEY_AQUI_NO_COMPARTIR
MEXC_SECRET_KEY=TU_SECRET_KEY_AQUI_NO_COMPARTIR
